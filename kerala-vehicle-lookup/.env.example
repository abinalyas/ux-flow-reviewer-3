# Copy to .env and fill in. Never commit the real file.

# ── Provider ──────────────────────────────────────────────────────────────────
# "mock"       — offline synthetic data, no network, no cost. Default.
# "aggregator" — a commercial VAHAN/eChallan reseller. Needs the values below.
PROVIDER=mock

# Mock tuning
MOCK_SYNTHESIZE=true
MOCK_LATENCY_MS=0

# ── Aggregator ────────────────────────────────────────────────────────────────
# Fill these from your vendor's docs. The defaults below match the most common
# request shape (Surepass-style); adjust per vendor.
AGGREGATOR_NAME=aggregator
AGGREGATOR_BASE_URL=
AGGREGATOR_TOKEN=
AGGREGATOR_RC_PATH=/api/v1/rc/rc-full
AGGREGATOR_CHALLAN_PATH=/api/v1/challan/challan
AGGREGATOR_ID_FIELD=id_number
AGGREGATOR_AUTH_HEADER=Authorization
AGGREGATOR_AUTH_SCHEME=Bearer
AGGREGATOR_TIMEOUT_MS=15000
AGGREGATOR_MAX_RETRIES=2

# ── Privacy ───────────────────────────────────────────────────────────────────
# "masked" (default) mirrors what the public VAHAN portal returns post-DPDP.
# Only set "full" if you have a lawful basis for unmasked personal data.
PRIVACY_MODE=masked
# Salt for hashing plates in the access log. Set to a random value per deploy.
AUDIT_SALT=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
