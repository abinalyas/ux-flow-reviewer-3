{
  "name": "kerala-vehicle-lookup",
  "version": "0.1.0",
  "private": true,
  "description": "Vehicle details and pending challan lookup by registration number, with a provider abstraction and an offline mock",
  "type": "commonjs",
  "main": "dist/src/service.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "lookup": "node dist/src/cli.js",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
