// Copy this file to Config/Secrets.xcconfig (git-ignored) and fill in your key.
//
// The YouTube Data API v3 key is optional: without it the app browses the bundled
// catalog.json and the search bar is hidden. With it, the phone gains YouTube search.
//
// Note the `$()` escape — xcconfig treats `//` as a comment even inside a value, so
// URLs and some keys need it. Plain API keys do not, but the pattern is here in case
// you swap in a value that contains a slash.
YOUTUBE_API_KEY =
